-- ==========================================
-- Apply Functions
-- ==========================================
local function applyColorCorrection()
    local cc = ensure("ColorCorrection", "ColorCorrectionEffect")
    cc.Brightness = Config.Brightness
    cc.Contrast = Config.Contrast
    cc.Saturation = Config.Saturation
    cc.TintColor = Config.TintColor
    cc.Enabled = Config.Enabled
end

local function applyBloom()
    local b = ensure("Bloom", "BloomEffect")
    b.Enabled = Config.Enabled and Config.BloomEnabled
    b.Intensity = Config.BloomIntensity
    b.Size = Config.BloomSize
    b.Threshold = Config.BloomThreshold
end

local function applyBlur()
    local b = ensure("Blur", "BlurEffect")
    b.Enabled = Config.Enabled and Config.BlurEnabled
    b.Size = Config.BlurSize
end

local function applyDOF()
    local d = ensure("DepthOfField", "DepthOfFieldEffect")
    d.Enabled = Config.Enabled and Config.DOFEnabled
    d.FocusDistance = Config.DOFFocus
    d.InFocusRadius = Config.DOFInFocus
    d.NearIntensity = 0.5
    d.FarIntensity = Config.DOFOutFocus / 10
end

local function applySunRays()
    local s = ensure("SunRays", "SunRaysEffect")
    s.Enabled = Config.Enabled and Config.SunRaysEnabled
    s.Intensity = Config.SunRaysIntensity
    s.Spread = Config.SunRaysSpread
end

local function applyAtmosphere()
    local a = Lighting:FindFirstChild("Shader_Atmosphere")
    if Config.Enabled and Config.AtmosEnabled then
        if not a then
            a = Instance.new("Atmosphere")
            a.Name = "Shader_Atmosphere"
            a.Parent = Lighting
        end
        a.Density = Config.AtmosDensity
        a.Offset = Config.AtmosOffset
        a.Color = Config.AtmosColor
        a.Decay = Config.AtmosDecay
        a.Haze = Config.AtmosHaze
        a.Glare = Config.AtmosGlare
    elseif a then
        a:Destroy()
    end
end

local function applyEnvironment()
    if not Config.Enabled then return end
    if Config.ClockTime then Lighting.ClockTime = Config.ClockTime end
    if Config.FogStart then Lighting.FogStart = Config.FogStart end
    if Config.FogEnd then Lighting.FogEnd = Config.FogEnd end
    if Config.FogColor then Lighting.FogColor = Config.FogColor end
    if Config.Ambient then Lighting.Ambient = Config.Ambient end
    if Config.Brightness then Lighting.Brightness = Config.Brightness end
    if Config.Exposure then Lighting.ExposureCompensation = Config.Exposure end
end

local function applyOverlays()
    updateVignette(Config.Enabled and Config.VignetteEnabled and Config.VignetteStrength or 0)
    updateScanlines(Config.Enabled and Config.ScanlinesEnabled, Config.ScanlinesOpacity)
end

local function applyAll()
    if not Config.Enabled then
        for name, obj in pairs(Effects) do
            if obj and obj.Parent then
                if obj:IsA("PostEffect") then obj.Enabled = false end
                if obj:IsA("ScreenGui") then obj.Enabled = false end
            end
        end
        local atmos = Lighting:FindFirstChild("Shader_Atmosphere")
        if atmos then atmos:Destroy() end
        return
    end
    -- Enable ScreenGuis
    for _, name in ipairs({"Vignette", "Scanlines"}) do
        if Effects[name] then Effects[name].Enabled = true end
    end
    applyColorCorrection()
    applyBloom()
    applyBlur()
    applyDOF()
    applySunRays()
    applyAtmosphere()
    applyEnvironment()
    applyOverlays()
end


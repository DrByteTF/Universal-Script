local Effects = {
    ColorCorrection = nil,
    Bloom = nil,
    Blur = nil,
    DepthOfField = nil,
    SunRays = nil,
    Atmosphere = nil,
    Vignette = nil,     -- ScreenGui overlay
    Scanlines = nil,    -- ScreenGui overlay
}

local function ensure(name, className)
    if Effects[name] and Effects[name].Parent then return Effects[name] end
    local obj = Instance.new(className)
    obj.Name = "Shader_" .. name
    obj.Parent = Lighting
    Effects[name] = obj
    return obj
end

local function ensureOverlay(name)
    if Effects[name] and Effects[name].Parent then return Effects[name] end
    local gui = Instance.new("ScreenGui")
    gui.Name = "Shader_" .. name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 100
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    Effects[name] = gui
    return gui
end

-- Vignette overlay
local function updateVignette(strength)
    local gui = ensureOverlay("Vignette")
    local frame = gui:FindFirstChild("V")
    if not frame then
        frame = Instance.new("Frame")
        frame.Name = "V"
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.BackgroundTransparency = 1
        frame.ZIndex = 100
        frame.Parent = gui
        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.6, 1),
            NumberSequenceKeypoint.new(1, 0.3),
        })
        grad.Rotation = 90
        grad.Parent = frame
    end
    -- Simple approach: black frame with alpha at edges via ImageLabel gradient
    local img = frame:FindFirstChild("Img")
    if not img then
        img = Instance.new("ImageLabel")
        img.Name = "Img"
        img.Size = UDim2.new(1, 0, 1, 0)
        img.BackgroundTransparency = 1
        img.Image = "rbxassetid://5028857472"
        img.ScaleType = Enum.ScaleType.Stretch
        img.Parent = frame
    end
    img.ImageTransparency = 1 - strength
end

-- Scanlines overlay
local function updateScanlines(enabled, opacity)
    local gui = ensureOverlay("Scanlines")
    local frame = gui:FindFirstChild("S")
    if not frame then
        frame = Instance.new("Frame")
        frame.Name = "S"
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.new(0, 0, 0)
        frame.BorderSizePixel = 0
        frame.ZIndex = 101
        frame.Parent = gui
        local img = Instance.new("ImageLabel")
        img.Name = "Img"
        img.Size = UDim2.new(1, 0, 1, 0)
        img.BackgroundTransparency = 1
        img.Image = "rbxassetid://5571182847"  -- thin scanline pattern
        img.ScaleType = Enum.ScaleType.Tile
        img.TileSize = UDim2.new(0, 4, 0, 4)
        img.Parent = frame
    end
    frame.Visible = enabled
    frame.BackgroundTransparency = 1 - opacity
    frame.Img.ImageTransparency = 1 - opacity
end

